{
  "name": "dynamic-subagents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "agent": "npm --workspace @dynamic-subagents/agent run start --",
    "check": "npm run typecheck && npm test",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "6.0.3"
  }
}
